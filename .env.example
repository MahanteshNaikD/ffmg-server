PORT=8080
NODE_ENV=development

# Heartbeat cadence in milliseconds (infrastructure setup)
HEARTBEAT_INTERVAL_MS=2000

# Directory where HLS outputs are written and served from /hls
HLS_ROOT=./hls-output

# Stream archive retention period in milliseconds (e.g., 30 minutes)
STREAM_RETENTION_MS=1800000

# Directory path prefix in GCS bucket
GCS_HLS_PREFIX=live_stream

# Optional: upload a rolling stream thumbnail with this object name.
GCS_THUMBNAIL_NAME=thumbnail.jpg
GCS_THUMBNAIL_INTERVAL_MS=10000

# Include nested `gcs` on stream-ended webhook. Set false if API uses forbidNonWhitelisted without gcs on DTO.
STREAM_ENDED_INCLUDE_GCS=true
